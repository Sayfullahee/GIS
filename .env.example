# =============================================================================
# CHER-CDSS Environment Configuration (.env)
# Master Implementation Scaffold v4.1 (October 2026)
# Copy this file to .env and adjust secure credentials before deployment.
# =============================================================================

# PostgreSQL / PostGIS Database Settings
POSTGRES_DB=cher_cdss
POSTGRES_USER=nhyppadec_admin
POSTGRES_PASSWORD=nhyppadec_secure_2026_change_in_prod
POSTGRES_PORT=5432

# GeoServer Map Server Settings
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver_nhyppadec_2026_change_in_prod
GEOSERVER_PORT=8080

# MinIO S3 Object Storage Settings
MINIO_ROOT_USER=nhyppadec_minio_admin
MINIO_ROOT_PASSWORD=minio_secret_key_2026_change_in_prod
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application Server Settings
APP_PORT=8000
APP_ENV=production

# =============================================================================
# KoboToolbox / ODK Central Ingestion Settings (Stage 5 & 6)
# =============================================================================
# Server URL: https://kf.kobotoolbox.org (Public) or https://kobo.humanitarianresponse.info (Humanitarian)
KOBO_SERVER_URL=https://kf.kobotoolbox.org

# 40-character API token from Account Settings -> Security / API Token
KOBO_API_TOKEN=your_40_character_kobo_token_here

# Asset UID / Form ID (from your deployed form URL: .../#/forms/{asset_uid}/summary)
KOBO_FORM_ID=aXXXXXXXXXXXXXXX
